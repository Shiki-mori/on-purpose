{
  "manifest_version": 3,
  "name": "有目的",
  "version": "0.1.0",
  "description": "在哔哩哔哩上询问目的并到时打断",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": [
    "https://*.bilibili.com/*",
    "https://bilibili.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "有目的",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.bilibili.com/*",
        "https://bilibili.com/*"
      ],
      "js": [
        "src/shared/constants.js",
        "src/sites/bilibili.js",
        "src/sites/index.js",
        "src/content/ui.js",
        "src/content/content-script.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/shared/theme.css"],
      "matches": [
        "https://*.bilibili.com/*",
        "https://bilibili.com/*"
      ]
    }
  ]
}
